---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTA from '../components/CTA.astro';
import '../styles/global.css';
---
<Layout title="Our Services - CareRideUS" description="Comprehensive medical transportation services: NEMT, wheelchair accessible transport, stretcher and bariatric transport, long distance medical transport. Book your ride today.">
  <Header />
  <main>
    <!-- Hero Section -->
    <section class="relative min-h-[50vh] sm:min-h-[60vh] flex items-center justify-center pt-18 lg:pt-20 overflow-hidden bg-gradient-mesh" aria-labelledby="services-hero-title">
      <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
        <div class="absolute top-1/4 left-1/4 w-96 h-96 rounded-full bg-[var(--color-accent)]/10 blur-3xl"></div>
        <div class="absolute bottom-1/4 right-1/4 w-96 h-96 rounded-full bg-[var(--color-secondary)]/10 blur-3xl"></div>
      </div>
      <div class="container relative z-10 px-4 py-16 lg:py-24 text-center">
        <span class="badge-accent mb-6 inline-block animate-slide-up">Our Services</span>
        <h1 id="services-hero-title" class="heading-1 text-[var(--color-primary)] mb-6 animate-slide-up delay-100">Medical Transportation Services</h1>
        <p class="body-lg max-w-3xl mx-auto animate-slide-up delay-200">Every service includes trained staff, sanitized vehicles, real-time tracking, and door-through-door assistance. We tailor each ride to the patient's specific needs.</p>
      </div>
    </section>

    <!-- NEMT Service -->
    <section id="nemt" class="section relative" aria-labelledby="nemt-title">
      <div class="container">
        <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
          <div class="animate-slide-up">
            <span class="badge-primary mb-6 inline-block">Core Service</span>
            <h2 id="nemt-title" class="heading-2 text-[var(--color-primary)] mb-6">Non-Emergency Medical Transport (NEMT)</h2>
            <p class="body-lg mb-8 text-[var(--color-text-muted)]">Our most common service for patients who need reliable transportation to medical appointments but don't require an ambulance. Perfect for routine care, follow-ups, and ongoing treatments.</p>
            <ul class="space-y-4 mb-10">
              {[
                "Doctor & specialist appointments",
                "Dialysis treatments (recurring schedules)",
                "Chemotherapy & radiation therapy",
                "Physical & occupational therapy",
                "Diagnostic imaging (MRI, CT, X-ray)",
                "Lab work & blood draws",
                "Wound care visits",
                "Mental health appointments",
              ].map(item => (
                <li class="flex items-start gap-4 group">
                  <div class="w-10 h-10 rounded-xl bg-[var(--color-accent)]/10 flex items-center justify-center shrink-0 group-hover:bg-[var(--color-accent)] group-hover:text-white transition-all duration-300" aria-hidden="true">
                    <svg class="w-5 h-5 text-[var(--color-accent)] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                  </div>
                  <span class="body-sm text-[var(--color-text)] pt-1">{item}</span>
                </li>
              ))}
            </ul>
            <a href="/contact" class="btn-primary">Schedule NEMT Ride</a>
          </div>
          <div class="relative animate-slide-up delay-200">
            <div class="aspect-[4/3] rounded-3xl bg-[var(--color-surface-alt)] flex items-center justify-center overflow-hidden border border-[var(--color-border)]/50">
              <div class="text-center p-12">
                <div class="w-24 h-24 rounded-2xl bg-gradient-to-br from-[var(--color-accent)]/10 to-[var(--color-secondary)]/10 flex items-center justify-center mx-auto mb-6" aria-hidden="true">
                  <svg class="w-12 h-12 text-[var(--color-accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>
                </div>
                <p class="text-[var(--color-text-muted)]">NEMT Vehicle Interior</p>
              </div>
            </div>
            <div class="absolute -bottom-6 -right-6 lg:-right-12 w-56 h-56 rounded-2xl bg-gradient-to-br from-[var(--color-accent)]/20 to-[var(--color-secondary)]/20" aria-hidden="true"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- Wheelchair Service -->
    <section id="wheelchair" class="section bg-[var(--color-surface-alt)]" aria-labelledby="wheelchair-title">
      <div class="container">
        <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
          <div class="lg:order-2 animate-slide-up">
            <span class="badge-secondary mb-6 inline-block">Accessibility</span>
            <h2 id="wheelchair-title" class="heading-2 text-[var(--color-primary)] mb-6">Wheelchair Accessible Transport</h2>
            <p class="body-lg mb-8 text-[var(--color-text-muted)]">ADA-compliant vehicles with hydraulic lifts, securement systems, and trained drivers who assist with transfers. We accommodate manual wheelchairs, power chairs, and scooters up to 600 lbs.</p>
            <ul class="space-y-4 mb-10">
              {[
                "Hydraulic lifts (not ramps) for smooth entry",
                "4-point Q'Straint securement systems",
                "Drivers trained in wheelchair handling & transfers",
                "Accommodates power chairs up to 600 lbs",
                "Companion seating for caregivers/family",
                "Climate-controlled interior",
                "Real-time tracking for family peace of mind",
              ].map(item => (
                <li class="flex items-start gap-4 group">
                  <div class="w-10 h-10 rounded-xl bg-[var(--color-secondary)]/10 flex items-center justify-center shrink-0 group-hover:bg-[var(--color-secondary)] group-hover:text-white transition-all duration-300" aria-hidden="true">
                    <svg class="w-5 h-5 text-[var(--color-secondary)] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                  </div>
                  <span class="body-sm text-[var(--color-text)] pt-1">{item}</span>
                </li>
              ))}
            </ul>
            <a href="/contact" class="btn-secondary">Book Wheelchair Ride</a>
          </div>
          <div class="relative animate-slide-up delay-200">
            <div class="aspect-[4/3] rounded-3xl bg-[var(--color-surface-alt)] flex items-center justify-center overflow-hidden border border-[var(--color-border)]/50">
              <div class="text-center p-12">
                <div class="w-24 h-24 rounded-2xl bg-gradient-to-br from-[var(--color-secondary)]/10 to-[#0d9488]/10 flex items-center justify-center mx-auto mb-6" aria-hidden="true">
                  <svg class="w-12 h-12 text-[var(--color-secondary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>
                </div>
                <p class="text-[var(--color-text-muted)]">Wheelchair Lift & Securement</p>
              </div>
            </div>
            <div class="absolute -bottom-6 -left-6 lg:-left-12 w-56 h-56 rounded-2xl bg-gradient-to-br from-[var(--color-secondary)]/20 to-[#0d9488]/20" aria-hidden="true"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- Stretcher Service -->
    <section id="stretcher" class="section relative" aria-labelledby="stretcher-title">
      <div class="container">
        <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
          <div class="animate-slide-up">
            <span class="badge-warm mb-6 inline-block">Specialized Care</span>
            <h2 id="stretcher-title" class="heading-2 text-[var(--color-primary)] mb-6">Stretcher & Bariatric Transport</h2>
            <p class="body-lg mb-8 text-[var(--color-text-muted)]">For patients who must remain in a supine position during transport. Our stretcher vans feature medical-grade stretchers, climate control, and two-person trained teams. Bariatric service available for patients up to 1,000 lbs with reinforced equipment.</p>
            <ul class="space-y-4 mb-10">
              {[
                "Medical-grade stretchers with side rails",
                "Two-person trained transport teams",
                "Bariatric capacity up to 1,000 lbs",
                "Reinforced ramps & winch systems",
                "Oxygen & basic monitoring available",
                "Privacy screens for dignity",
                "Hospital-to-hospital & home transfers",
              ].map(item => (
                <li class="flex items-start gap-4 group">
                  <div class="w-10 h-10 rounded-xl bg-[var(--color-warm)]/10 flex items-center justify-center shrink-0 group-hover:bg-[var(--color-warm)] group-hover:text-white transition-all duration-300" aria-hidden="true">
                    <svg class="w-5 h-5 text-[var(--color-warm)] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                  </div>
                  <span class="body-sm text-[var(--color-text)] pt-1">{item}</span>
                </li>
              ))}
            </ul>
            <a href="/contact" class="btn bg-[var(--color-warm)] text-white hover:bg-[var(--color-warm-light)] shadow-lg shadow-[var(--color-warm)]/25 hover:shadow-xl hover:shadow-[var(--color-warm)]/30">Arrange Stretcher Transport</a>
          </div>
          <div class="relative animate-slide-up delay-200">
            <div class="aspect-[4/3] rounded-3xl bg-[var(--color-surface-alt)] flex items-center justify-center overflow-hidden border border-[var(--color-border)]/50">
              <div class="text-center p-12">
                <div class="w-24 h-24 rounded-2xl bg-gradient-to-br from-[var(--color-warm)]/10 to-[var(--color-warm-light)]/10 flex items-center justify-center mx-auto mb-6" aria-hidden="true">
                  <svg class="w-12 h-12 text-[var(--color-warm)]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" /></svg>
                </div>
                <p class="text-[var(--color-text-muted)]">Stretcher Van Configuration</p>
              </div>
            </div>
            <div class="absolute -bottom-6 -right-6 lg:-right-12 w-56 h-56 rounded-2xl bg-gradient-to-br from-[var(--color-warm)]/20 to-[var(--color-warm-light)]/20" aria-hidden="true"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- Long Distance Service -->
    <section id="long-distance" class="section bg-[var(--color-surface-alt)]" aria-labelledby="long-distance-title">
      <div class="container">
        <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
          <div class="lg:order-2 animate-slide-up">
            <span class="badge mb-6 inline-block" style="background: linear-gradient(135deg, rgba(139, 92, 246, 0.1), rgba(168, 85, 247, 0.1)); color: #8b5cf6;">Extended Range</span>
            <h2 id="long-distance-title" class="heading-2 text-[var(--color-primary)] mb-6">Long Distance Medical Transport</h2>
            <p class="body-lg mb-8 text-[var(--color-text-muted)]">Inter-city and inter-state transport for patients seeking specialized care at distant facilities. Comfortable vehicles with medical monitoring capabilities, scheduled rest stops, and overnight options for extended journeys.</p>
            <ul class="space-y-4 mb-10">
              {[
                "Inter-city & inter-state transport",
                "Specialized cancer centers & research hospitals",
                "Comfort stops every 2-3 hours",
                "Overnight driver teams for 12+ hour trips",
                "Family member may accompany at no extra cost",
                "Coordination with receiving facility",
                "Insurance & Medicaid coordination available",
              ].map(item => (
                <li class="flex items-start gap-4 group">
                  <div class="w-10 h-10 rounded-xl bg-[#8b5cf6]/10 flex items-center justify-center shrink-0 group-hover:bg-[#8b5cf6] group-hover:text-white transition-all duration-300" aria-hidden="true">
                    <svg class="w-5 h-5 text-[#8b5cf6] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                  </div>
                  <span class="body-sm text-[var(--color-text)] pt-1">{item}</span>
                </li>
              ))}
            </ul>
            <a href="/contact" class="btn bg-[#8b5cf6] text-white hover:bg-[#7c3aed] shadow-lg shadow-[#8b5cf6]/25 hover:shadow-xl hover:shadow-[#8b5cf6]/30">Get Long Distance Quote</a>
          </div>
          <div class="relative animate-slide-up delay-200">
            <div class="aspect-[4/3] rounded-3xl bg-[var(--color-surface-alt)] flex items-center justify-center overflow-hidden border border-[var(--color-border)]/50">
              <div class="text-center p-12">
                <div class="w-24 h-24 rounded-2xl bg-gradient-to-br from-[#8b5cf6]/10 to-[#a855f7]/10 flex items-center justify-center mx-auto mb-6" aria-hidden="true">
                  <svg class="w-12 h-12 text-[#8b5cf6]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                </div>
                <p class="text-[var(--color-text-muted)]">Long Distance Comfort Vehicle</p>
              </div>
            </div>
            <div class="absolute -bottom-6 -left-6 lg:-left-12 w-56 h-56 rounded-2xl bg-gradient-to-br from-[#8b5cf6]/20 to-[#a855f7]/20" aria-hidden="true"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="section relative overflow-hidden bg-gradient-to-br from-[var(--color-primary)] via-[var(--color-primary-light)] to-[var(--color-primary)]" aria-labelledby="services-cta-title">
      <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
        <div class="absolute top-1/4 left-1/4 w-96 h-96 rounded-full bg-[var(--color-accent)]/10 blur-3xl"></div>
        <div class="absolute bottom-1/4 right-1/4 w-96 h-96 rounded-full bg-[var(--color-secondary)]/10 blur-3xl"></div>
      </div>
      <div class="container relative z-10 text-center max-w-3xl mx-auto animate-slide-up">
        <h2 id="services-cta-title" class="heading-2 text-white mb-6">Not Sure Which Service You Need?</h2>
        <p class="body-lg text-white/80 mb-10">Our scheduling team will assess your needs and recommend the right transport option. No obligation consultation.</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="/contact" class="btn bg-white text-[var(--color-primary)] hover:bg-white/90 text-lg px-10 py-4 w-full sm:w-auto shadow-xl shadow-[var(--color-primary)]/25">Book a Ride</a>
          <a href="tel:+18005550199" class="btn border-2 border-white/30 text-white hover:border-white hover:bg-white/10 text-lg px-10 py-4 w-full sm:w-auto flex items-center justify-center gap-2">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
            Call (800) 555-0199
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>