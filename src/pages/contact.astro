---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---
<Layout title="Contact & Book a Ride - CareRideUS" description="Book a medical transport ride online or contact CareRideUS. Phone: (800) 555-0199. Email: info@carerideus.com. Online booking form available 24/7.">
  <Header />
  <main>
    <!-- Hero Section -->
    <section class="relative min-h-[50vh] sm:min-h-[60vh] flex items-center justify-center pt-18 lg:pt-20 overflow-hidden bg-gradient-mesh" aria-labelledby="contact-hero-title">
      <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
        <div class="absolute top-1/4 left-1/4 w-96 h-96 rounded-full bg-[var(--color-accent)]/10 blur-3xl"></div>
        <div class="absolute bottom-1/4 right-1/4 w-96 h-96 rounded-full bg-[var(--color-secondary)]/10 blur-3xl"></div>
      </div>
      <div class="container relative z-10 px-4 py-16 lg:py-24 text-center">
        <span class="badge-accent mb-6 inline-block animate-slide-up">Contact Us</span>
        <h1 id="contact-hero-title" class="heading-1 text-[var(--color-primary)] mb-6 animate-slide-up delay-100">Book a Ride or Contact Us</h1>
        <p class="body-lg max-w-3xl mx-auto animate-slide-up delay-200">Schedule online in minutes or call our 24/7 scheduling team. We'll confirm your ride within 15 minutes during business hours.</p>
      </div>
    </section>

    <!-- Contact Form & Info -->
    <section class="section relative -mt-16 lg:-mt-20" aria-labelledby="booking-title">
      <div class="container relative z-10">
        <div class="grid lg:grid-cols-3 gap-8 lg:gap-12">
          <!-- Contact Info Cards -->
          <div class="lg:col-span-1 space-y-6 animate-slide-up">
            <div class="card-elevated p-6">
              <div class="w-12 h-12 rounded-xl bg-[var(--color-accent)]/10 flex items-center justify-center mb-4 text-[var(--color-accent)]" aria-hidden="true">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
              </div>
              <h3 class="heading-4 text-[var(--color-primary)] mb-2">Call to Book</h3>
              <a href="tel:+18005550199" class="text-2xl font-bold text-[var(--color-primary)] hover:text-[var(--color-accent)] transition-colors block mb-1">(800) 555-0199</a>
              <p class="body-sm">24/7 scheduling support</p>
            </div>

            <div class="card-elevated p-6">
              <div class="w-12 h-12 rounded-xl bg-[var(--color-secondary)]/10 flex items-center justify-center mb-4 text-[var(--color-secondary)]" aria-hidden="true">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
              </div>
              <h3 class="heading-4 text-[var(--color-primary)] mb-2">Email Us</h3>
              <a href="mailto:info@carerideus.com" class="text-[var(--color-accent)] hover:text-[var(--color-accent-dark)] transition-colors block mb-1">info@carerideus.com</a>
              <a href="mailto:billing@carerideus.com" class="text-[var(--color-accent)] hover:text-[var(--color-accent-dark)] transition-colors block text-sm mb-2">billing@carerideus.com</a>
              <p class="body-sm">Responses within 2 hours business hours</p>
            </div>

            <div class="card-elevated p-6">
              <div class="w-12 h-12 rounded-xl bg-[var(--color-warm)]/10 flex items-center justify-center mb-4 text-[var(--color-warm)]" aria-hidden="true">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
              </div>
              <h3 class="heading-4 text-[var(--color-primary)] mb-2">Office Location</h3>
              <address class="not-italic body-sm leading-relaxed">
                123 Medical Center Dr, Suite 100<br />
                Healthcare District, HC 12345
              </address>
              <p class="body-sm mt-2">Mon-Fri: 6AM - 8PM | Sat-Sun: 8AM - 6PM</p>
            </div>
          </div>

          <!-- Booking Form -->
          <div class="lg:col-span-2 animate-slide-up delay-100">
            <form id="booking-form" class="card-elevated p-6 lg:p-8" action="https://api.web3forms.com/submit" method="POST">
              <input type="hidden" name="access_key" value="YOUR_WEB3FORMS_KEY" />
              <input type="hidden" name="subject" value="CareRideUS Booking Request" />
              <input type="hidden" name="redirect" value="/contact?success=true" />

              <div class="flex items-center justify-between mb-8">
                <div>
                  <h2 id="booking-title" class="heading-3 text-[var(--color-primary)] mb-1">Online Booking Request</h2>
                  <p class="body-sm">Fill out the form below and we'll confirm within 15 minutes.</p>
                </div>
              </div>

              <div class="grid md:grid-cols-2 gap-6 mb-6">
                <div>
                  <label for="service-type" class="label">Service Type *</label>
                  <select id="service-type" name="service_type" class="input" required>
                    <option value="">Select service</option>
                    <option value="nemt">Non-Emergency Medical Transport (NEMT)</option>
                    <option value="wheelchair">Wheelchair Accessible Transport</option>
                    <option value="stretcher">Stretcher Transport</option>
                    <option value="bariatric">Bariatric Transport (up to 1,000 lbs)</option>
                    <option value="long-distance">Long Distance Medical Transport</option>
                    <option value="unsure">Not Sure - Need Guidance</option>
                  </select>
                </div>
                <div>
                  <label for="trip-type" class="label">Trip Type *</label>
                  <select id="trip-type" name="trip_type" class="input" required>
                    <option value="">Select trip type</option>
                    <option value="one-way">One Way</option>
                    <option value="round-trip">Round Trip</option>
                    <option value="recurring">Recurring (Weekly/Monthly)</option>
                  </select>
                </div>
              </div>

              <div class="grid md:grid-cols-2 gap-6 mb-6">
                <div>
                  <label for="pickup-date" class="label">Pickup Date *</label>
                  <input type="date" id="pickup-date" name="pickup_date" class="input" required min={new Date().toISOString().split('T')[0]} />
                </div>
                <div>
                  <label for="pickup-time" class="label">Pickup Time *</label>
                  <input type="time" id="pickup-time" name="pickup_time" class="input" required />
                </div>
              </div>

              <div class="grid md:grid-cols-2 gap-6 mb-6">
                <div>
                  <label for="pickup-location" class="label">Pickup Address *</label>
                  <textarea id="pickup-location" name="pickup_location" class="input min-h-[100px] resize-y" rows="3" required placeholder="Street address, facility name, apartment/unit #"></textarea>
                </div>
                <div>
                  <label for="dropoff-location" class="label">Drop-off Address *</label>
                  <textarea id="dropoff-location" name="dropoff_location" class="input min-h-[100px] resize-y" rows="3" required placeholder="Street address, facility name, department/suite #"></textarea>
                </div>
              </div>

              <div class="grid md:grid-cols-2 gap-6 mb-6">
                <div>
                  <label for="passenger-name" class="label">Passenger Name *</label>
                  <input type="text" id="passenger-name" name="passenger_name" class="input" required placeholder="Full name of passenger" />
                </div>
                <div>
                  <label for="passenger-phone" class="label">Passenger Phone *</label>
                  <input type="tel" id="passenger-phone" name="passenger_phone" class="input" required placeholder="(555) 123-4567" />
                </div>
              </div>

              <div class="grid md:grid-cols-2 gap-6 mb-6">
                <div>
                  <label for="contact-name" class="label">Your Name (if different)</label>
                  <input type="text" id="contact-name" name="contact_name" class="input" placeholder="Your full name" />
                </div>
                <div>
                  <label for="contact-phone" class="label">Your Phone *</label>
                  <input type="tel" id="contact-phone" name="contact_phone" class="input" required placeholder="(555) 123-4567" />
                </div>
              </div>

              <div class="mb-6">
                <label for="contact-email" class="label">Your Email *</label>
                <input type="email" id="contact-email" name="contact_email" class="input" required placeholder="you@example.com" />
              </div>

              <div class="mb-6">
                <label for="special-instructions" class="label">Special Instructions / Medical Notes</label>
                <textarea id="special-instructions" name="special_instructions" class="input min-h-[120px] resize-y" rows="4" placeholder="Oxygen needed, mobility details, equipment, language preference, insurance info, etc."></textarea>
              </div>

              <div class="flex items-start gap-3 mb-8">
                <input type="checkbox" id="terms" name="terms" class="mt-1 w-5 h-5 rounded border-[var(--color-border)] text-[var(--color-accent)] focus:ring-2 focus:ring-[var(--color-accent)]/20" required />
                <label for="terms" class="body-sm text-[var(--color-text-muted)]">I agree to the <a href="/terms" class="link">Terms of Service</a> and <a href="/privacy" class="link">Privacy Policy</a>, and authorize CareRideUS to contact me regarding this booking. *</label>
              </div>

              <button type="submit" class="btn-primary w-full sm:w-auto text-lg px-10 py-4" id="submit-btn">Submit Booking Request</button>

              <p class="body-sm text-center mt-6">We'll confirm your booking within 15 minutes during business hours. For urgent same-day needs, please call <a href="tel:+18005550199" class="font-semibold text-[var(--color-accent)] hover:text-[var(--color-accent-dark)]">(800) 555-0199</a>.</p>
            </form>

            <div id="form-success" class="hidden card-elevated p-6 lg:p-8 text-center bg-[var(--color-success)]/5 border border-[var(--color-success)]/20">
              <div class="w-16 h-16 rounded-full bg-[var(--color-success)]/10 flex items-center justify-center mx-auto mb-4 text-[var(--color-success)]" aria-hidden="true">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
              </div>
              <h3 class="heading-3 text-[var(--color-success)] mb-2">Booking Request Submitted!</h3>
              <p class="body text-[var(--color-success)]/80 mb-6">Thank you! Our scheduling team will contact you within 15 minutes to confirm your ride details.</p>
              <a href="/" class="btn bg-[var(--color-success)] text-white hover:bg-[var(--color-success)]/90 px-8 py-3">Return Home</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section id="faq" class="section bg-[var(--color-surface-alt)]" aria-labelledby="faq-title">
      <div class="container">
        <div class="text-center max-w-3xl mx-auto mb-16 lg:mb-20 animate-slide-up">
          <span class="badge-secondary mb-6 inline-block">Frequently Asked Questions</span>
          <h2 id="faq-title" class="heading-2 text-[var(--color-primary)] mb-6">Quick Answers</h2>
          <p class="body-lg">Everything you need to know about booking and using our service.</p>
        </div>

        <div class="max-w-3xl mx-auto space-y-4 animate-slide-up delay-100">
          {[
            {
              q: "How far in advance should I book?",
              a: "We recommend booking at least 48 hours in advance for guaranteed availability. However, we often accommodate same-day requests—call (800) 555-0199 for urgent needs."
            },
            {
              q: "Do you accept insurance / Medicaid / Medicare?",
              a: "Yes! We work with Medicare, Medicaid, most private insurers, and managed care plans. We handle direct billing for approved trips. Provide your insurance info when booking and we'll verify coverage."
            },
            {
              q: "Can a family member or caregiver ride along?",
              a: "Absolutely. One companion rides free with the patient. Additional companions may be accommodated based on vehicle capacity—let us know when booking."
            },
            {
              q: "What if my appointment runs late?",
              a: "We track appointment times and build in buffer. If your appointment runs over, your driver will wait (up to 30 minutes included). Extended wait time is billed at a nominal rate."
            },
            {
              q: "Do you provide door-through-door service?",
              a: "Yes. Our drivers assist from your door, through lobbies, elevators, and to the check-in desk. We don't just drop you at the curb."
            },
            {
              q: "What safety measures do you take?",
              a: "All vehicles are sanitized with hospital-grade disinfectant between every ride. Drivers wear masks upon request. HEPA filtration in all vehicles. Hand sanitizer available. Real-time GPS tracking on every trip."
            },
          ].map((faq, i) => (
            <details class="card-elevated group animate-slide-up" open={i === 0} style={{ animationDelay: `${i * 50}ms` }}>
              <summary class="flex items-center justify-between cursor-pointer list-none p-6 lg:p-8 font-medium text-[var(--color-primary)]">
                {faq.q}
                <svg class="w-5 h-5 text-[var(--color-text-light)] group-open:rotate-180 transition-transform duration-200 shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
              </summary>
              <div class="px-6 lg:px-8 pb-6 lg:pb-8 pt-4 border-t border-[var(--color-border)]/50 body">{faq.a}</div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Insurance Section -->
    <section id="insurance" class="section relative" aria-labelledby="insurance-title">
      <div class="container">
        <div class="text-center max-w-3xl mx-auto mb-12 lg:mb-16 animate-slide-up">
          <span class="badge-primary mb-6 inline-block">Insurance & Payment</span>
          <h2 id="insurance-title" class="heading-2 text-[var(--color-primary)] mb-6">We Work With Your Coverage</h2>
          <p class="body-lg">We work with most major insurers and offer flexible payment options for self-pay patients.</p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 mb-12 lg:mb-16 animate-slide-up delay-100">
          {[
            { title: "Medicare", desc: "Part B covers NEMT when medically necessary", color: "from-[var(--color-accent)] to-[var(--color-accent-dark)]", icon: "M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" },
            { title: "Medicaid", desc: "NEMT benefit in most state plans", color: "from-[var(--color-secondary)] to-[#0d9488]", icon: "M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" },
            { title: "Private Insurance", desc: "Most major carriers accepted", color: "from-[var(--color-warm)] to-[var(--color-warm-light)]", icon: "M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" },
            { title: "Self-Pay", desc: "Competitive rates, payment plans available", color: "from-[#8b5cf6] to-[#a855f7]", icon: "M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" },
          ].map((item, i) => (
            <div class="card-elevated p-6 text-center group animate-slide-up" style={`animation-delay: ${i * 100}ms`}>
              <div class={`w-14 h-14 rounded-2xl bg-gradient-to-br ${item.color}/10 flex items-center justify-center mx-auto mb-4 group-hover:bg-gradient-to-br group-hover:${item.color} group-hover:text-white transition-all duration-300`} aria-hidden="true">
                <svg class="w-7 h-7 text-[var(--color-accent)] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon} /></svg>
              </div>
              <h3 class="heading-4 text-[var(--color-primary)] mb-2">{item.title}</h3>
              <p class="body-sm">{item.desc}</p>
            </div>
          ))}
        </div>

        <div class="card-elevated p-6 lg:p-8 text-center bg-gradient-to-r from-[var(--color-accent)]/5 to-[var(--color-secondary)]/5 border-[var(--color-accent)]/20 animate-slide-up delay-200">
          <div class="w-12 h-12 rounded-xl bg-[var(--color-accent)]/10 flex items-center justify-center mx-auto mb-4 text-[var(--color-accent)]" aria-hidden="true">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          </div>
          <p class="body mb-6">Have questions about coverage? Our billing team will verify your benefits at no cost.</p>
          <a href="tel:+18005550199" class="btn-secondary">Call to Verify Insurance</a>
        </div>
      </div>
    </section>

    <!-- How to Book Section -->
    <section id="booking" class="section bg-[var(--color-surface-alt)]" aria-labelledby="booking-process-title">
      <div class="container">
        <div class="text-center max-w-3xl mx-auto mb-12 lg:mb-16 animate-slide-up">
          <span class="badge-warm mb-6 inline-block">Simple Process</span>
          <h2 id="booking-process-title" class="heading-2 text-[var(--color-primary)] mb-6">How to Book in 3 Easy Steps</h2>
          <p class="body-lg">Three easy ways to schedule your medical transportation.</p>
        </div>

        <div class="grid md:grid-cols-3 gap-6 lg:gap-8">
          {[
            { step: "1", title: "Submit Request", desc: "Fill out our online form or call our 24/7 scheduling line with trip details.", icon: "M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-4 4h4m-4 4h4m-6-4v12" },
            { step: "2", title: "We Confirm", desc: "Our team verifies details, checks insurance, and sends confirmation with driver info.", icon: "M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" },
            { step: "3", title: "We Arrive", desc: "Driver arrives on time, assists passenger door-through-door to appointment.", icon: "M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" },
          ].map((step, i) => (
            <article class="card-elevated p-6 lg:p-8 text-center relative group animate-slide-up" style={`animation-delay: ${i * 150}ms`}>
              <div class="absolute -top-4 left-1/2 -translate-x-1/2 w-12 h-12 rounded-full bg-gradient-to-br from-[var(--color-accent)] to-[var(--color-secondary)] flex items-center justify-center text-white font-bold text-xl" aria-hidden="true">{step.step}</div>
              <div class="mt-8">
                <div class="w-14 h-14 rounded-2xl bg-[var(--color-accent)]/10 flex items-center justify-center mx-auto mb-4 group-hover:bg-[var(--color-accent)] group-hover:text-white transition-all duration-300" aria-hidden="true">
                  <svg class="w-7 h-7 text-[var(--color-accent)] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={step.icon} /></svg>
                </div>
                <h3 class="heading-4 text-[var(--color-primary)] mb-2">{step.title}</h3>
                <p class="body-sm">{step.desc}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script is:inline>
  // Check for success redirect
  const urlParams = new URLSearchParams(window.location.search);
  if (urlParams.get('success') === 'true') {
    document.getElementById('booking-form').classList.add('hidden');
    document.getElementById('form-success').classList.remove('hidden');
  }

  // Form submission handling
  const form = document.getElementById('booking-form');
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submitBtn = document.getElementById('submit-btn');
      const originalText = submitBtn.textContent;
      submitBtn.textContent = 'Submitting...';
      submitBtn.disabled = true;

      try {
        const formData = new FormData(form);
        const response = await fetch(form.action, {
          method: 'POST',
          body: formData,
          headers: { 'Accept': 'application/json' }
        });

        if (response.ok) {
          form.classList.add('hidden');
          document.getElementById('form-success').classList.remove('hidden');
        } else {
          throw new Error('Submission failed');
        }
      } catch (error) {
        submitBtn.textContent = originalText;
        submitBtn.disabled = false;
        alert('Something went wrong. Please try again or call (800) 555-0199.');
      }
    });
  }
</script>