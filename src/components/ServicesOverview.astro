---
const services = [
  {
    id: "nemt",
    title: "Non-Emergency Medical Transport",
    description: "Scheduled transportation for doctor appointments, dialysis, chemotherapy, physical therapy, and routine checkups. Door-through-door assistance included.",
    icon: "M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-4 4h4m-4 4h4m-6-4v12",
    color: "from-[var(--color-accent)] to-[var(--color-accent-dark)]",
    link: "/services#nemt",
  },
  {
    id: "wheelchair",
    title: "Wheelchair Accessible Transport",
    description: "ADA-compliant vehicles with hydraulic lifts and securement systems. Trained drivers assist with transfers and ensure safe, comfortable rides.",
    icon: "M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10",
    color: "from-[var(--color-secondary)] to-[#0d9488]",
    link: "/services#wheelchair",
  },
  {
    id: "stretcher",
    title: "Stretcher & Bariatric Transport",
    description: "Specialized stretcher vans for patients who must remain supine. Bariatric-capable vehicles with reinforced equipment and additional staff for larger patients.",
    icon: "M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z",
    color: "from-[var(--color-warm)] to-[var(--color-warm-light)]",
    link: "/services#stretcher",
  },
  {
    id: "long-distance",
    title: "Long Distance Medical Transport",
    description: "Inter-city and inter-state transport for specialized care. Comfortable vehicles with medical monitoring capabilities for extended journeys.",
    icon: "M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z",
    color: "from-[#8b5cf6] to-[#a855f7]",
    link: "/services#long-distance",
  },
];
---
<section id="services" class="section relative overflow-hidden" aria-labelledby="services-title">
  <div class="container relative z-10">
    <!-- Section header -->
    <div class="text-center max-w-3xl mx-auto mb-16 lg:mb-20 animate-slide-up">
      <span class="badge-accent mb-6 inline-block animate-fade-in">Our Services</span>
      <h2 id="services-title" class="heading-2 text-[var(--color-primary)] mb-6">Comprehensive Medical Transport Solutions</h2>
      <p class="body-lg">Tailored to each patient's unique needs. Every ride includes trained staff, sanitized vehicles, real-time tracking, and door-through-door assistance.</p>
    </div>

    <!-- Service cards -->
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
      {services.map((service, i) => (
        <article class="card-elevated group relative overflow-hidden animate-slide-up" style={{ animationDelay: `${i * 100}ms` }}>
          <!-- Color accent bar -->
          <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r {service.color}"></div>
          
          <div class="p-6 lg:p-8 h-full flex flex-col">
            <!-- Icon -->
            <div class="relative w-14 h-14 rounded-2xl bg-gradient-to-br {service.color}/10 flex items-center justify-center mb-6 group-hover:bg-gradient-to-br group-hover:{service.color} group-hover:text-white transition-all duration-300" aria-hidden="true">
              <svg class="w-7 h-7 text-[var(--color-accent)] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={service.icon} /></svg>
            </div>

            <!-- Content -->
            <h3 class="heading-4 text-[var(--color-primary)] mb-3">{service.title}</h3>
            <p class="body-sm flex-1 mb-6">{service.description}</p>

            <!-- Link -->
            <a href={service.link} class="inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-accent)] hover:text-[var(--color-accent-dark)] transition-colors group w-fit">
              Learn more
              <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- View all button -->
    <div class="text-center mt-12 lg:mt-16 animate-slide-up delay-300">
      <a href="/services" class="btn-outline px-10 py-4 text-lg">View All Services</a>
    </div>
  </div>

  <!-- Background decoration -->
  <div class="absolute bottom-0 left-0 right-0 h-40 bg-gradient-to-t from-[var(--color-surface-alt)] to-transparent pointer-events-none" aria-hidden="true"></div>
</section>