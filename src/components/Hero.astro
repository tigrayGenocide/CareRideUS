---
interface Props {
  title?: string;
  subtitle?: string;
}
const { title = "Compassionate Medical Transportation<br/>That Puts Patients First", subtitle = "Safe, reliable, and dignified non-emergency medical transport. Door-through-door service with trained professionals who care about every journey." } = Astro.props;
---
<section class="relative min-h-screen flex items-center justify-center pt-18 lg:pt-20 overflow-hidden bg-gradient-mesh" aria-labelledby="hero-title">
  <!-- Background decorative elements -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute top-1/4 left-1/4 w-96 h-96 rounded-full bg-[var(--color-accent)]/10 blur-3xl animate-pulse-soft"></div>
    <div class="absolute bottom-1/4 right-1/4 w-96 h-96 rounded-full bg-[var(--color-secondary)]/10 blur-3xl animate-pulse-soft" style="animation-delay: 1s;"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full bg-gradient-to-r from-[var(--color-accent)]/5 to-[var(--color-secondary)]/5 blur-3xl"></div>
  </div>

  <!-- Floating particles -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    {Array.from({ length: 20 }).map((_, i) => (
      <div class="absolute w-1.5 h-1.5 rounded-full bg-[var(--color-accent)]/20 animate-pulse-soft" style={{ 
        left: `${Math.random() * 100}%`, 
        top: `${Math.random() * 100}%`,
        animationDelay: `${Math.random() * 3}s`,
        animationDuration: `${3 + Math.random() * 2}s`
      }}></div>
    ))}
  </div>

  <div class="container relative z-10 px-4 py-16 lg:py-24">
    <div class="max-w-5xl mx-auto text-center">
      <!-- Trust badge -->
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/80 backdrop-blur-xl border border-[var(--color-border)]/50 shadow-lg mb-8 animate-slide-up" role="status">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[var(--color-accent)] opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-[var(--color-accent)]"></span>
        </span>
        <span class="text-sm font-medium text-[var(--color-text)]">Available 24/7 for Scheduled Rides</span>
      </div>

      <!-- Main headline -->
      <h1 id="hero-title" class="heading-1 text-[var(--color-primary)] mb-8 animate-slide-up delay-100">{title}</h1>
      
      <!-- Subtitle -->
      <p class="body-lg max-w-3xl mx-auto mb-12 animate-slide-up delay-200 text-balance">{subtitle}</p>

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 animate-slide-up delay-300">
        <a href="/contact" class="btn-primary w-full sm:w-auto text-lg px-10 py-4 shadow-xl shadow-[var(--color-primary)]/25">
          <span>Book a Ride Now</span>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
        </a>
        <a href="tel:+18005550199" class="btn-outline w-full sm:w-auto text-lg px-10 py-4 flex items-center justify-center gap-2">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
          <span>Call (800) 555-0199</span>
        </a>
      </div>

      <!-- Trust indicators -->
      <div class="mt-16 animate-slide-up delay-400">
        <div class="flex flex-wrap items-center justify-center gap-8 sm:gap-12 text-sm text-[var(--color-text-light)] mb-8">
          <span class="flex items-center gap-2 font-medium text-[var(--color-text-muted)]">Trusted by:</span>
          <span class="font-semibold text-[var(--color-text)]">Regional Medical Center</span>
          <span class="font-semibold text-[var(--color-text)]">Sunrise Dialysis</span>
          <span class="font-semibold text-[var(--color-text)]">Hope Oncology</span>
          <span class="font-semibold text-[var(--color-text)]">Senior Living Communities</span>
        </div>
      </div>
    </div>

    <!-- Stats bar -->
    <div class="mt-20 relative z-10 animate-slide-up delay-500">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
        {[
          { value: "10,000+", label: "Rides Completed", icon: "M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-4 4h4m-4 4h4m-6-4v12" },
          { value: "99.2%", label: "On-Time Rate", icon: "M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" },
          { value: "4.9★", label: "Patient Rating", icon: "M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.836 2.777a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.836-2.777a1 1 0 00-1.176 0l-3.836 2.777c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.836-2.777a1 1 0 00.587-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" },
          { value: "50+", label: "Partner Facilities", icon: "M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" },
        ].map((stat, i) => (
          <div class="relative group bg-white/80 backdrop-blur-xl border border-[var(--color-border)]/50 rounded-2xl p-6 lg:p-8 text-center hover:border-[var(--color-accent)]/30 hover:shadow-xl transition-all duration-300" style={{ animationDelay: `${i * 100}ms` }}>
            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-[var(--color-accent)]/10 to-[var(--color-secondary)]/10 flex items-center justify-center mx-auto mb-4 text-[var(--color-accent)] group-hover:from-[var(--color-accent)] group-hover:to-[var(--color-secondary)] group-hover:text-white transition-all duration-300" aria-hidden="true">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={stat.icon} /></svg>
            </div>
            <div class="text-3xl sm:text-4xl lg:text-5xl font-bold text-[var(--color-primary)] leading-none mb-1">{stat.value}</div>
            <div class="text-[var(--color-text-muted)] font-medium">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-10 left-1/2 -translate-x-1/2 animate-bounce" aria-hidden="true">
      <svg class="w-6 h-6 text-[var(--color-text-light)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" /></svg>
    </div>
  </div>
</section>