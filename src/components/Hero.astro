---
interface Props {
  title?: string;
  subtitle?: string;
}
const { title = "Safe, Reliable Medical Transportation", subtitle = "CareRideUS provides compassionate non-emergency medical transport for patients who need assistance getting to appointments, treatments, and care facilities. Door-to-door service with trained professionals." } = Astro.props;
---
<section class="relative min-h-screen flex items-center justify-center pt-16 bg-gradient-to-b from-primary/5 via-white to-secondary/5" aria-labelledby="hero-title">
  <div class="container-custom px-4 py-20 lg:py-32">
    <div class="max-w-4xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary/10 text-primary text-sm font-medium mb-6" role="status">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-primary"></span>
        </span>
        Available 24/7 for Scheduled Rides
      </div>
      <h1 id="hero-title" class="text-4xl sm:text-5xl lg:text-6xl font-bold text-gray-900 leading-tight mb-6">{title}</h1>
      <p class="text-lg sm:text-xl text-gray-600 mb-10 max-w-3xl mx-auto">{subtitle}</p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/contact" class="btn-primary text-lg px-8 py-4 w-full sm:w-auto">Book a Ride Now</a>
        <a href="tel:+18005550199" class="btn-outline text-lg px-8 py-4 w-full sm:w-auto flex items-center justify-center gap-2">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
          Call (800) 555-0199
        </a>
      </div>
    </div>

    <div class="mt-20 grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-8 text-center">
      <div class="p-6 bg-white rounded-xl border border-gray-100 shadow-sm">
        <div class="text-3xl sm:text-4xl font-bold text-primary mb-1">10,000+</div>
        <div class="text-gray-600">Rides Completed</div>
      </div>
      <div class="p-6 bg-white rounded-xl border border-gray-100 shadow-sm">
        <div class="text-3xl sm:text-4xl font-bold text-primary mb-1">99.2%</div>
        <div class="text-gray-600">On-Time Rate</div>
      </div>
      <div class="p-6 bg-white rounded-xl border border-gray-100 shadow-sm">
        <div class="text-3xl sm:text-4xl font-bold text-primary mb-1">4.9★</div>
        <div class="text-gray-600">Patient Rating</div>
      </div>
      <div class="p-6 bg-white rounded-xl border border-gray-100 shadow-sm">
        <div class="text-3xl sm:text-4xl font-bold text-primary mb-1">50+</div>
        <div class="text-gray-600">Partner Facilities</div>
      </div>
    </div>
  </div>

  <div class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-white to-transparent pointer-events-none" aria-hidden="true"></div>
</section>