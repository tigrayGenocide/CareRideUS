<section class="section bg-gray-50" aria-labelledby="features-title">
  <div class="container-custom">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 id="features-title" class="section-title">Why Choose CareRideUS</h2>
      <p class="section-subtitle">We understand medical transportation isn't just about getting from A to B. It's about safety, dignity, and peace of mind for patients and their families.</p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {features.map(feature => (
        <article class="card p-6">
          <div class="w-12 h-12 rounded-lg bg-primary/10 text-primary flex items-center justify-center mb-4" aria-hidden="true">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={feature.icon} /></svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">{feature.title}</h3>
          <p class="text-gray-600">{feature.description}</p>
        </article>
      ))}
    </div>
  </div>
