---
const testimonials = [
  {
    quote: "CareRideUS has been a lifeline for my mother's dialysis appointments. The drivers are patient, kind, and always on time. I never worry about her safety.",
    author: "Sarah M.",
    role: "Daughter of patient",
    rating: 5,
  },
  {
    quote: "As a care coordinator, I rely on CareRideUS for our most complex transports. Their stretcher team handles bariatric patients with dignity and professionalism every time.",
    author: "James R., RN",
    role: "Discharge Planner, Regional Medical Center",
    rating: 5,
  },
  {
    quote: "The wheelchair-accessible vans are spotless and the lifts work smoothly. My husband feels safe and respected. We've used them for 2 years without a single issue.",
    author: "Linda T.",
    role: "Caregiver",
    rating: 5,
  },
  {
    quote: "Insurance billing is seamless. They handle all the paperwork with Medicare and our supplemental plan. Zero hassle for our office staff.",
    author: "Maria K.",
    role: "Practice Manager, Family Medicine",
    rating: 5,
  },
];
---
<section class="section bg-white" aria-labelledby="testimonials-title">
  <div class="container-custom">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 id="testimonials-title" class="section-title">Trusted by Patients & Providers</h2>
      <p class="section-subtitle">See what families, care coordinators, and healthcare partners say about their experience with CareRideUS.</p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
      {testimonials.map(testimonial => (
        <article class="card p-6">
          <div class="flex gap-1 mb-4" aria-label={`Rating: ${testimonial.rating} out of 5 stars`}>
            {Array.from({ length: 5 }).map((_, i) => (
              <svg class="w-5 h-5 text-accent fill-current" viewBox="0 0 20 20" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
            ))}
          </div>
          <p class="text-gray-700 mb-4 italic">"{testimonial.quote}"</p>
          <div>
            <p class="font-semibold text-gray-900">{testimonial.author}</p>
            <p class="text-sm text-gray-500">{testimonial.role}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>