---
const testimonials = [
  {
    quote: "CareRideUS has been a lifeline for my mother's dialysis appointments. The drivers are patient, kind, and always on time. I never worry about her safety.",
    author: "Sarah M.",
    role: "Daughter of patient",
    avatar: "SM",
    rating: 5,
  },
  {
    quote: "As a care coordinator, I rely on CareRideUS for our most complex transports. Their stretcher team handles bariatric patients with dignity and professionalism every time.",
    author: "James R., RN",
    role: "Discharge Planner, Regional Medical Center",
    avatar: "JR",
    rating: 5,
  },
  {
    quote: "The wheelchair-accessible vans are spotless and the lifts work smoothly. My husband feels safe and respected. We've used them for 2 years without a single issue.",
    author: "Linda T.",
    role: "Caregiver",
    avatar: "LT",
    rating: 5,
  },
  {
    quote: "Insurance billing is seamless. They handle all the paperwork with Medicare and our supplemental plan. Zero hassle for our office staff.",
    author: "Maria K.",
    role: "Practice Manager, Family Medicine",
    avatar: "MK",
    rating: 5,
  },
  {
    quote: "My father needed stretcher transport for a 200-mile trip to a specialist. The team was incredible—comfortable, communicative, and caring throughout the entire journey.",
    author: "Robert P.",
    role: "Son of patient",
    avatar: "RP",
    rating: 5,
  },
  {
    quote: "We partner with CareRideUS for all our patient transport needs. Their reliability and communication have made them an essential part of our care continuum.",
    author: "Dr. Amanda S.",
    role: "Medical Director, Senior Living Community",
    avatar: "AS",
    rating: 5,
  },
];
---
<section class="section relative overflow-hidden" aria-labelledby="testimonials-title">
  <div class="container relative z-10">
    <!-- Section header -->
    <div class="text-center max-w-3xl mx-auto mb-16 lg:mb-20 animate-slide-up">
      <span class="badge-secondary mb-6 inline-block">Testimonials</span>
      <h2 id="testimonials-title" class="heading-2 text-[var(--color-primary)] mb-6">Trusted by Patients & Providers</h2>
      <p class="body-lg">See what families, care coordinators, and healthcare partners say about their experience with CareRideUS.</p>
    </div>

    <!-- Testimonials grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {testimonials.map((testimonial, i) => (
        <article class="card-elevated p-6 lg:p-8 flex flex-col animate-slide-up" style={{ animationDelay: `${i * 100}ms` }}>
          <!-- Rating -->
          <div class="flex gap-1 mb-4" aria-label={`Rating: ${testimonial.rating} out of 5 stars`}>
            {Array.from({ length: 5 }).map((_, j) => (
              <svg class="w-5 h-5 text-[var(--color-warm)] fill-current" viewBox="0 0 20 20" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
            ))}
          </div>

          <!-- Quote -->
          <p class="body flex-1 mb-6 relative">"{testimonial.quote}"</p>

          <!-- Author -->
          <div class="flex items-center gap-4 pt-4 border-t border-[var(--color-border)]/50">
            <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-[var(--color-accent)]/20 to-[var(--color-secondary)]/20 flex items-center justify-center text-[var(--color-accent)] font-bold text-lg shrink-0" aria-hidden="true">{testimonial.avatar}</div>
            <div>
              <p class="font-semibold text-[var(--color-primary)]">{testimonial.author}</p>
              <p class="text-sm text-[var(--color-text-light)]">{testimonial.role}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>