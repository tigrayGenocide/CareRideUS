---
interface Props {
  title?: string;
  subtitle?: string;
  primaryText?: string;
  primaryHref?: string;
  secondaryText?: string;
  secondaryHref?: string;
}
const {
  title = "Ready to Schedule a Ride?",
  subtitle = "Book online in minutes or call our 24/7 scheduling team. We'll handle the details so you can focus on care.",
  primaryText = "Book Online",
  primaryHref = "/contact",
  secondaryText = "Call Now",
  secondaryHref = "tel:+18005550199",
} = Astro.props;
---
<section class="section bg-primary text-white" aria-labelledby="cta-title">
  <div class="container-custom text-center">
    <h2 id="cta-title" class="text-3xl sm:text-4xl font-bold mb-4">{title}</h2>
    <p class="text-primary-100 text-lg mb-8 max-w-2xl mx-auto">{subtitle}</p>
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href={primaryHref} class="btn bg-white text-primary hover:bg-gray-100 text-lg px-8 py-4 w-full sm:w-auto">{primaryText}</a>
      <a href={secondaryHref} class="btn border-2 border-white text-white hover:bg-white/10 text-lg px-8 py-4 w-full sm:w-auto flex items-center justify-center gap-2">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
        {secondaryText}
      </a>
    </div>
  </div>
</section>