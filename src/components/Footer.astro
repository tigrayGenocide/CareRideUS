---
const footerLinks = {
  company: [
    { href: "/about", label: "About Us" },
    { href: "/services", label: "Our Services" },
    { href: "/contact", label: "Contact" },
    { href: "/careers", label: "Careers" },
  ],
  services: [
    { href: "/services#nemt", label: "NEMT Transport" },
    { href: "/services#wheelchair", label: "Wheelchair Transport" },
    { href: "/services#stretcher", label: "Stretcher Transport" },
    { href: "/services#long-distance", label: "Long Distance" },
    { href: "/services#bariatric", label: "Bariatric Transport" },
  ],
  resources: [
    { href: "/contact#faq", label: "FAQ" },
    { href: "/contact#insurance", label: "Insurance & Billing" },
    { href: "/contact#booking", label: "How to Book" },
    { href: "/privacy", label: "Privacy Policy" },
    { href: "/terms", label: "Terms of Service" },
  ],
  contact: {
    phone: "(800) 555-0199",
    email: "info@carerideus.com",
    address: "123 Medical Center Dr, Suite 100\nHealthcare District, HC 12345",
    hours: "Mon-Fri: 6AM - 8PM\nSat-Sun: 8AM - 6PM",
  },
};
---
<footer class="bg-[var(--color-primary)] text-[var(--color-text-light)]" role="contentinfo">
  <div class="container py-20 lg:py-28">
    <div class="grid grid-cols-2 lg:grid-cols-5 gap-10 lg:gap-12">
      <div class="lg:col-span-2 space-y-6">
        <a href="/" class="flex items-center gap-3 text-xl font-bold text-white shrink-0" aria-label="CareRideUS Home">
          <span class="relative flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-[var(--color-accent)] to-[var(--color-secondary)]" aria-hidden="true">
            <svg class="w-6 h-6" viewBox="0 0 32 32" fill="none" aria-hidden="true">
              <path d="M8 16L14 22L24 10" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
          <span>CareRideUS</span>
        </a>
        <p class="text-[var(--color-text-light)] leading-relaxed max-w-xs">Safe, reliable, and compassionate non-emergency medical transportation. We get you to care on time, every time.</p>
        <div class="flex items-center gap-4">
          <a href="#" class="w-10 h-10 rounded-xl bg-white/5 flex items-center justify-center text-[var(--color-text-light)] hover:bg-[var(--color-accent)]/20 hover:text-[var(--color-accent)] transition-all duration-200" aria-label="Facebook"><svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg></a>
          <a href="#" class="w-10 h-10 rounded-xl bg-white/5 flex items-center justify-center text-[var(--color-text-light)] hover:bg-[var(--color-accent)]/20 hover:text-[var(--color-accent)] transition-all duration-200" aria-label="Twitter"><svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M23 3a10.9 10.9 0 01-3.14 1.53 4.48 4.48 0 00-7.86 3v1A10.66 10.66 0 013 4s-4 9 5 13a11.64 11.64 0 01-7 2c9 5 20 0 20-11.5a4.5 4.5 0 00-.08-.83A7.72 7.72 0 0023 3z"/></svg></a>
          <a href="#" class="w-10 h-10 rounded-xl bg-white/5 flex items-center justify-center text-[var(--color-text-light)] hover:bg-[var(--color-accent)]/20 hover:text-[var(--color-accent)] transition-all duration-200" aria-label="LinkedIn"><svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2zM4 6a2 2 0 100-4 2 2 0 000 4z"/></svg></a>
          <a href="#" class="w-10 h-10 rounded-xl bg-white/5 flex items-center justify-center text-[var(--color-text-light)] hover:bg-[var(--color-accent)]/20 hover:text-[var(--color-accent)] transition-all duration-200" aria-label="Instagram"><svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4s1.791-4 4-4 4 1.791 4 4-1.79 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.441s.645 1.441 1.441 1.441c.795 0 1.439-.645 1.439-1.441s-.644-1.441-1.439-1.441z"/></svg></a>
        </div>
      </div>

      <nav aria-label="Company links" class="space-y-4">
        <h3 class="font-semibold text-white uppercase tracking-wider text-xs">Company</h3>
        <ul class="space-y-3">
          {footerLinks.company.map(link => (
            <li><a href={link.href} class="text-sm hover:text-[var(--color-accent)] transition-colors">{link.label}</a></li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Services links" class="space-y-4">
        <h3 class="font-semibold text-white uppercase tracking-wider text-xs">Services</h3>
        <ul class="space-y-3">
          {footerLinks.services.map(link => (
            <li><a href={link.href} class="text-sm hover:text-[var(--color-accent)] transition-colors">{link.label}</a></li>
          ))}
        </ul>
      </nav>

      <div class="space-y-4">
        <h3 class="font-semibold text-white uppercase tracking-wider text-xs">Contact Us</h3>
        <address class="not-italic text-sm space-y-4 leading-relaxed">
          <div class="flex items-start gap-3">
            <span class="w-8 h-8 rounded-xl bg-white/5 flex items-center justify-center shrink-0 text-[var(--color-accent)]"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg></span>
            <div>
              <a href={`tel:${footerLinks.contact.phone}`} class="text-white hover:text-[var(--color-accent)] transition-colors block">{footerLinks.contact.phone}</a>
              <span class="text-[var(--color-text-light)]">24/7 Scheduling</span>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <span class="w-8 h-8 rounded-xl bg-white/5 flex items-center justify-center shrink-0 text-[var(--color-accent)]"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg></span>
            <a href={`mailto:${footerLinks.contact.email}`} class="text-white hover:text-[var(--color-accent)] transition-colors">{footerLinks.contact.email}</a>
          </div>
          <div class="flex items-start gap-3">
            <span class="w-8 h-8 rounded-xl bg-white/5 flex items-center justify-center shrink-0 text-[var(--color-accent)]"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg></span>
            <span class="whitespace-pre-line">{footerLinks.contact.address}</span>
          </div>
          <div class="flex items-start gap-3">
            <span class="w-8 h-8 rounded-xl bg-white/5 flex items-center justify-center shrink-0 text-[var(--color-accent)]"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg></span>
            <span class="whitespace-pre-line text-[var(--color-text-light)]">{footerLinks.contact.hours}</span>
          </div>
        </address>
      </div>
    </div>

    <div class="mt-16 pt-10 border-t border-white/10">
      <div class="flex flex-col lg:flex-row items-center justify-between gap-6">
        <p class="text-sm text-[var(--color-text-light)]">&copy; {new Date().getFullYear()} CareRideUS. All rights reserved.</p>
        <div class="flex items-center gap-6 text-sm text-[var(--color-text-light)]">
          <a href="/privacy" class="hover:text-[var(--color-accent)] transition-colors">Privacy Policy</a>
          <a href="/terms" class="hover:text-[var(--color-accent)] transition-colors">Terms of Service</a>
          <a href="/accessibility" class="hover:text-[var(--color-accent)] transition-colors">Accessibility</a>
        </div>
      </div>
    </div>
  </div>
</footer>